{
  email admin@lastdish.kr
}

lastdish.kr, www.lastdish.kr {
  encode zstd gzip
  root * /srv/lastdish

  @staticAssets path /_expo/* /assets/* /favicon.ico
  header @staticAssets Cache-Control "public, max-age=31536000, immutable"
  @appPages not path /_expo/* /assets/* /favicon.ico
  header @appPages Cache-Control "no-cache, no-store, must-revalidate"

  try_files {path} {path}.html {path}/ /index.html
  file_server
}

grafana.lastdish.kr {
  encode zstd gzip
  reverse_proxy grafana:3000
}

log.lastdish.kr {
  basic_auth {
    {$LOKI_BASIC_AUTH_USER} {$LOKI_BASIC_AUTH_HASH}
  }
  handle /api/v1/write {
    reverse_proxy prometheus:9090
  }
  handle {
    reverse_proxy loki:3100
  }
}

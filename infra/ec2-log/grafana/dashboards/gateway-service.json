    {
      "id": 301,
      "type": "timeseries",
      "title": "HTTP 4xx·5xx 비율",
      "description": "Actuator를 제외한 전체 HTTP 요청 중 4xx와 5xx가 차지하는 비율입니다. 4xx 증가는 요청·인증 문제, 5xx 증가는 서버 내부 실패를 우선 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "4xx 비율"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx 비율"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }

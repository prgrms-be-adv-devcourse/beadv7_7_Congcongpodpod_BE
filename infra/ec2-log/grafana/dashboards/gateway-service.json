    {
      "id": 1118,
      "type": "timeseries",
      "title": "Main EC2 CPU Load Average",
      "description": "실행 중이거나 CPU를 기다리는 작업 수입니다. 2 vCPU 서버에서 5분 Load가 2 이상 지속되면 CPU 경합을 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [

        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",

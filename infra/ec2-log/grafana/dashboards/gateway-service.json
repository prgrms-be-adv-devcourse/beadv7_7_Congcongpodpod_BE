      },
      "panels": [

      ]
    },
    {
      "id": 110,
      "type": "bargauge",
      "title": "Main EC2 자원 사용률",
      "description": "CPU·RAM·디스크 사용률·디스크 여유율·CPU I/O 대기율·Swap 사용률을 하나의 가로 막대 패널로 표시합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "디스크 여유율"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "green",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Swap"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "red",
                      "value": 50
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "maxVizHeight": 300,
        "minVizHeight": 12,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (1 - avg (rate(node_cpu_seconds_total{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\",mode=\"idle\"}[30s])))",
          "legendFormat": "CPU",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\"} / node_memory_MemTotal_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\"})",
          "legendFormat": "RAM",
          "range": true
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "루트 디스크",
          "range": true
        },
        {
          "refId": "D",
          "editorMode": "code",
          "expr": "100 * avg (rate(node_cpu_seconds_total{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\",mode=\"iowait\"}[30s]))",
          "legendFormat": "CPU I/O 대기",
          "range": true
        },
        {
          "refId": "E",
          "editorMode": "code",
          "expr": "100 * node_filesystem_avail_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "디스크 여유율",
          "range": true
        },
        {
          "refId": "F",
          "editorMode": "code",
          "expr": "100 * (node_memory_SwapTotal_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\"} - node_memory_SwapFree_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\"}) / clamp_min(node_memory_SwapTotal_bytes{job=\"main-node-exporter\",server=\"Main EC2\",instance=\"ssh-tunnel:19100\"}, 1)",
          "legendFormat": "Swap",
          "range": true
        }
      ]
    },

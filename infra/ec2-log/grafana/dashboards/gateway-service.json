      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"kubernetes-spring-pods\",application=\"gateway-service\",uri!~\"/actuator.*\",status=~\"4..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"kubernetes-spring-pods\",application=\"gateway-service\",uri!~\"/actuator.*\"}[1m])), 0.000001)",
          "legendFormat": "4xx 비율",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",

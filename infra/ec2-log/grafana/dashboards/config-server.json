{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "서비스 로그 열기 ↗",
      "tooltip": "Loki 로그 대시보드를 새 탭에서 엽니다.",
      "type": "link",
      "url": "/d/lastdish-service-logs/service-logs?var-namespace=platform&var-application=config-server"
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "서비스 상태",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "description": "서비스와 주요 의존성의 현재 상태 및 Pod 재시작 여부를 빠르게 확인하는 영역입니다."
    },
    {
      "id": 101,
      "type": "row",
      "title": "애플리케이션 리소스",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": [],
      "description": "서비스 Pod의 CPU·메모리·JVM·요청 처리 지표입니다. 배포 직후 급증과 지속적인 한도 근접 여부를 확인합니다."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 500,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{application=\"config-server\"} !~ \"(?i)(org.apache.kafka|SubscriptionState|ConsumerCoordinator|KafkaMessageListener|partitions assigned|Found no committed offset|Resetting offset)\" | json | message != \"\" | line_format \"[{{if .log_level}}{{.log_level}}{{else}}INFO{{end}}] {{.message}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Config Server 실시간 로그",
      "type": "logs",
      "description": "최신 서비스 로그를 실시간으로 확인합니다."
    },
    {
      "id": 1,
      "type": "stat",
      "title": "설정 서버 상태",
      "description": "Prometheus scrape 상태입니다. 1이면 정상입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "wideLayout": false
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max(up{job=\"kubernetes-spring-pods\",application=\"config-server\"})",
          "legendFormat": "config-server",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU 사용률(%) 및 사용량(mCPU)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\(mCPU\\).*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "mcores"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum((rate(container_cpu_usage_seconds_total{namespace=\"platform\",pod=~\"config-server-.*\",container!=\"\",image!=\"\"}[30s]) and on(namespace,pod,container) (time() - container_last_seen{namespace=\"platform\",pod=~\"config-server-.*\",container!=\"\",image!=\"\"} < 60))) / sum(kube_pod_container_resource_limits{namespace=\"platform\",pod=~\"config-server-.*\",resource=\"cpu\",unit=\"core\"})",
          "legendFormat": "CPU 사용률 (Limit 기준 %)",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum((rate(container_cpu_usage_seconds_total{namespace=\"platform\",pod=~\"config-server-.*\",container!=\"\",image!=\"\"}[30s]) and on(namespace,pod,container) (time() - container_last_seen{namespace=\"platform\",pod=~\"config-server-.*\",container!=\"\",image!=\"\"} < 60))) * 1000",
          "legendFormat": "실제 사용량 (mCPU)",
          "range": true
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"platform\",pod=~\"config-server-.*\",resource=\"cpu\",unit=\"core\"}) * 1000",
          "legendFormat": "예약량 (mCPU)",
          "range": true
        },
        {
          "refId": "D",
          "editorMode": "code",
          "expr": "sum(kube_pod_container_resource_limits{namespace=\"platform\",pod=~\"config-server-.*\",resource=\"cpu\",unit=\"core\"}) * 1000",
          "legendFormat": "최대할당 Limit (mCPU)",
          "range": true
        }
      ],
      "description": "컨테이너에 할당된 CPU Limit 기준 사용률(%)과 실제 사용량(mCPU)을 함께 표시합니다."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "메모리 사용량과 상한",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum((container_memory_working_set_bytes{namespace=\"platform\",pod=~\"config-server-.*\",container!=\"\",image!=\"\"} and on(namespace,pod,container) (time() - container_last_seen{namespace=\"platform\",pod=~\"config-server-.*\",container!=\"\",image!=\"\"} < 60)))",
          "legendFormat": "사용량",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(kube_pod_container_resource_limits{namespace=\"platform\",pod=~\"config-server-.*\",resource=\"memory\",unit=\"byte\"})",
          "legendFormat": "상한",
          "range": true
        }
      ],
      "description": "Pod working set과 OOM 종료 기준인 memory limit을 비교합니다. 사용량이 상한에 계속 근접하면 메모리 누수·JVM 설정·limit을 점검합니다."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 힙 사용량",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{job=\"kubernetes-spring-pods\",application=\"config-server\",area=\"heap\"})",
          "legendFormat": "힙 사용량",
          "range": true
        }
      ],
      "description": "JVM heap 사용량입니다. Pod 전체 메모리가 아니며, 지속 상승 후 GC에도 회복되지 않으면 메모리 누수를 의심합니다."
    },

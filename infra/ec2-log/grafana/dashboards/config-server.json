    },
    {
      "id": 301,
      "type": "timeseries",
      "title": "HTTP 4xx·5xx 비율",
      "description": "Actuator를 제외한 전체 HTTP 요청 중 4xx와 5xx가 차지하는 비율입니다. 4xx 증가는 요청·인증 문제, 5xx 증가는 서버 내부 실패를 우선 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "4xx 비율"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx 비율"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\",status=~\"4..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\"}[1m])), 0.000001)",
          "legendFormat": "4xx 비율",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\",status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\"}[1m])), 0.000001)",
          "legendFormat": "5xx 비율",
          "range": true
        }
      ]
    },
    {
      "id": 302,
      "type": "timeseries",
      "title": "HTTP 응답시간 평균·p95·p99",
      "description": "평균은 전체 경향, p95·p99는 느린 상위 요청의 지연을 보여줍니다. p95·p99는 histogram 활성화 이후 수집된 요청부터 계산됩니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "평균"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\"}[1m])), 0.000001)",
          "legendFormat": "평균",
          "range": true
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"kubernetes-spring-pods\",application=\"config-server\",uri!~\"/actuator.*\"}[1m])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },

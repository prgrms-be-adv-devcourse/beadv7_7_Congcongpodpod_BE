# dev/.env로 복사해 사용하는 로컬 Docker Compose 전용 설정입니다.
# 실제 Toss 결제 테스트 시 발급받은 테스트 키로 교체하세요.
TOSS_CLIENT_KEY=test_ck_placeholder
TOSS_SECRET_KEY=test_sk_placeholder

# AES가 허용하는 16·24·32바이트 중 하나를 사용합니다.
# 아래 값은 로컬 개발 전용 32바이트 예시이며 운영 키와 공유하지 않습니다.
ENCRYPTION_SECRET_KEY=local-dev-aes-key-32-bytes-long!

# 로컬 Redis와 Elasticsearch 인증값입니다.
REDIS_PASSWORD=redis_local_password
ELASTICSEARCH_PASSWORD=elastic_local_password

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_ADMIN_KEY=

# Core의 이미지 업로드를 실제 AWS S3에 연결하려면 true와 아래 값을 설정합니다.
# 배포 환경은 access key 대신 인스턴스·워크로드 IAM Role 사용을 권장합니다.
S3_ENABLED=false
S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# AWS S3는 비워두며, S3 호환 저장소를 사용할 때만 URL을 입력합니다.
S3_ENDPOINT=
S3_PRESIGNED_URL_EXPIRATION=5m
S3_MAX_UPLOAD_SIZE=10MB

#AI 모델이 들어있는 FastApi 주소입니다.
AI_ENGINE_URL=

#open AI 키값입니다.
OPENAI_API_KEY=

# 개발·시연 더미데이터를 함께 생성합니다. seed가 필요 없으면 classpath:db/migration만 지정합니다.
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

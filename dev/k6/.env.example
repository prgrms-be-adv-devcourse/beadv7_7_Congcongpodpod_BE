# k6 실행 환경변수. 이 파일을 .env로 복사해서 쓴다.

# 대상 서버. 운영은 https://api.lastdish.kr, 로컬 게이트웨이는 http://host.docker.internal:8000 형태다.
BASE_URL=https://api.lastdish.kr

# 재현 가능한 실행을 위해 k6 이미지를 digest로 고정한다. 컨테이너 환경변수로는 전달하지 않는다.
K6_IMAGE=grafana/k6@sha256:5221b620a4f874faff6e32ba597aa667c058391fe4898b1c6f6377f062c6cdec

# 시드 계정 공통 비밀번호 (dev/README.md 참고)
SEED_PASSWORD=LastDish!2026

# 사용자 행동 사이 대기시간(초) 범위
THINK_MIN=1
THINK_MAX=3

# verify-flow 전용. 구매자와 매장 사용자 계정 번호를 다르게 둬 자기 매장 주문을 막는다.
BUYER_ACCOUNT=1
SELLER_ACCOUNT=2

# 장기 운영 시뮬레이션의 현재 KST 날짜와 1~5일차 단계
CAMPAIGN_DATE=20260824
CAMPAIGN_DAY=1

# 매일 초기화될 수 있는 DB 세대. 업무 이메일·매장명에는 넣지 않고 결과 구분에만 사용한다.
DATASET_EPOCH=20260824-a
RUN_ID=ld273-20260824-a-day1

# 컨테이너 안에서 읽을 당일 상태 파일 경로. Task 4에서 생성한다.
STATE_FILE=/scripts/results/ld273-20260824-a-day1-state.json

# 신규 loadtest 계정 전용 비밀번호. 실제 값은 Git에 올리지 않는 .env에서만 설정한다.
LOADTEST_PASSWORD=change-me-before-data-creation

# 시간대별 기본 계정 수와 일일 재구성 준비 설정
SLOTS_PER_WINDOW=10
PREPARE_LIMIT=
PREPARE_SHARDS=4
PREPARE_SHARD_INDEX=0

# seller001~150 각각이 시작 전에 보유해야 하는 최소 예치금
MIN_BUYER_BALANCE=10000000

# daily-operations 실행 모드. 운영 전 1회 검증은 CALIBRATION=1, 비운영 시간표 검증은 0.001을 사용한다.
CALIBRATION=0
SCHEDULE_SCALE=1
# 09:30 기준 이미 지난 분. 정식 시작은 0, 12:38 재개는 188이다.
SCHEDULE_OFFSET_MINUTES=0

# stress-recovery 전용. 16:50 인프라 게이트를 통과한 뒤에만 승인값을 1로 바꾼다.
# BASELINE_P95_MS에는 당일 10분 유휴 기준선의 실제 p95 밀리초 값을 넣는다.
BASELINE_P95_MS=
STRESS_APPROVED=0
